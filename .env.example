# ============================================================
# AgentIQ Environment Configuration Template
# Copy this file to .env and replace placeholders with real keys
# ============================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Primary Application PostgreSQL Database (with pgvector)
# Format: postgresql+psycopg://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://agentiq_user:agentiq_password@localhost:5432/agentiq_db
# Test database URL for isolated unit tests
TEST_DATABASE_URL=postgresql+psycopg://agentiq_user:agentiq_password@localhost:5432/agentiq_test_db

# Dedicated Read-Only User for SQL Analytics Tool (Least Privilege)
ANALYTICS_DATABASE_URL=postgresql+psycopg://analytics_reader:readonly_password@localhost:5432/agentiq_db

# AI Model Provider Configuration
# Supported providers: "openai", "gemini", "mock" (offline testing)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# OpenAI API Settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Google Gemini API Settings (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Document Processing & Ingestion
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# RAG & Retrieval Settings
DEFAULT_TOP_K=4
DEFAULT_SIMILARITY_THRESHOLD=0.45

# Agent Safeguards
AGENT_MAX_STEPS=4
AGENT_TIMEOUT_SECONDS=15
SQL_QUERY_TIMEOUT_MS=3000
SQL_MAX_ROWS=50

